# Application settings
DEBUG=True
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# Use "ollama:model_name" for Ollama embeddings
EMBEDDING_MODEL=ollama:llama2

# Snowflake settings (uncomment and fill to enable Snowflake integration)
#SNOWFLAKE_ACCOUNT=your_account
#SNOWFLAKE_USER=your_username

# Authentication options (in order of preference):
# 1. Private key authentication (most secure)
#SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/your/rsa_key.p8
#SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase_if_needed

# 2. Password from file
#SNOWFLAKE_PASSWORD_FILE=/path/to/your/password_file.txt

# 3. Direct password (least secure)
#SNOWFLAKE_PASSWORD=your_password

# Other Snowflake settings
#SNOWFLAKE_DATABASE=your_database
#SNOWFLAKE_SCHEMA=your_schema
#SNOWFLAKE_WAREHOUSE=your_warehouse
#SNOWFLAKE_ROLE=your_role
